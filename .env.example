# =============================================================================
# GRABBER POZ SOLO — Environment template
# Copy to .env.local and fill secrets. Never commit real keys.
# Guides: docs/COOLIFY_4_CLIENT_DEPLOYMENT_PLAYBOOK.md
# =============================================================================

# ─── Core (required) ───
# Coolify: internal Docker network URL to this tenant's own private Postgres
# container, e.g. postgresql://postgres:PASSWORD@grabber-db-<slug>:5432/grabber_<slug>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grabber_business_os

# APP_URL (not NEXT_PUBLIC_APP_URL) is what server code reads — see
# src/lib/config/app-url.ts. NEXT_PUBLIC_APP_URL is build-time inlined into
# the client bundle and can't vary per tenant on a shared image; set it too
# only if something client-side genuinely needs it.
APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

AUTH_SECRET=replace-with-openssl-rand-hex-48
MASTER_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
# Required to decrypt disaster-recovery backups at /api/backup/restore.
# No caller-supplied header is honored for this — server config only.
# BACKUP_ENCRYPTION_KEY=
STORE_NAME=Grabber Poz Solo

# Root `/` landing: company = Grabber marketing site; storefront = client shop
# grabberpoz.com / www → company landing. Every merchant subdomain, including
# demo.grabberpoz.com → that merchant's storefront. Merchant apps set
# LANDING_MODE=storefront; the demo app serves both apex and demo. hosts, so it
# leaves LANDING_MODE unset and lets the host decide.
# LANDING_MODE=company
# LANDING_MODE=storefront
# COMPANY_LANDING_HOSTS=grabberpoz.com,www.grabberpoz.com
# Where the company landing's "Storefront Demo" / "Staff Portal" links go:
# COMPANY_DEMO_URL=https://demo.grabberpoz.com

# ─── Object storage (optional — storage-only via plain fetch, no SDK) ───
# Uploads fall back to local public/uploads (mount a volume in Coolify) when
# unset. Prefer SUPABASE_URL over NEXT_PUBLIC_SUPABASE_URL for the same
# build-time-inlining reason as APP_URL above.
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── LKR payment gateways (optional — shop checkout is COD today) ───
# Set when enabling online LKR checkout + PayHere webhook at /api/webhooks/payhere
# PAYMENTS_LKR_PROVIDER=WEBXPAY
# PAYMENTS_LKR_PROVIDER=PAYHERE
# WEBXPAY_ENV=staging
# WEBXPAY_PUBLIC_KEY=
# WEBXPAY_SECRET_KEY=
# PAYHERE_MERCHANT_ID=
# PAYHERE_SECRET=
# PAYHERE_MODE=live

# ─── Global payments (optional — not wired in storefront checkout yet) ───
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Marketing pixels (optional — or configure in staff UI /marketing) ───
# Env values apply until staff saves IDs in /marketing (DB overrides env).
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CONVERSIONS_API_TOKEN=
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─── Messaging & logistics (optional) ───
# App reads WHATSAPP_PHONE_ID or WHATSAPP_PHONE_NUMBER_ID (Meta dashboard name)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=  # required — no default; webhook handshake fails closed if unset
# Required when Meta app has "Require App Secret" — used for webhook signature + Graph API appsecret_proof
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
# Staff WhatsApp escalation target when customer replies 3 (defaults to log-only if unset)
# OWNER_WHATSAPP=9477XXXXXXX
# CRON_SECRET=  # Bearer token for /api/cron/process-jobs; hit every 1-2 min by host crontab

# ─── Observability (Grabber Managed Cloud / VPS testing) ───
# Create a Sentry project; paste DSN. App no-ops if unset.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=grabber@1.0.0
# SENTRY_ORG=
# SENTRY_PROJECT=

# ─── Creative Engine (optional) ───
# GPU video worker — NOT on Vercel. Run creative-engine/main.py on GPU host.
# CREATIVE_WORKER_URL=http://localhost:8765
# Image fallback for dev/small renders (Vercel-safe):
# FAL_KEY=
# REPLICATE_API_TOKEN=
# KOOMBIYO_API_KEY=

# CERTIFY_HTTP_BASE_URL=https://your-tenant.grabberpoz.com
