# =============================================================================
# GRABBER BUSINESS OS (SOLO) — Environment template
# Copy to .env.local and fill secrets. Never commit real keys.
# Fresh deploy guide: docs/FRESH_START.md · Vercel env: docs/VERCEL_ENV.md
# =============================================================================

# ─── Core (required) ───
# App / Vercel (transaction pooler):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Vercel Supabase integration injects POSTGRES_URL automatically — app reads that too.
# POSTGRES_URL=
# Local migrations only (direct — do not use on Vercel):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-base64-48
MASTER_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

NEXT_PUBLIC_STORE_NAME=Grabber Poz Solo

# ─── Supabase client (optional — storage / future RLS client) ───
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Vercel sync (optional) ───
# VERCEL_PROJECT=my-new-project-slug

# ─── Ops scripts ───
# npm run db:bootstrap    # apply migrations 0000–0002 + column align (preferred)
# npm run db:align-columns  # idempotent missing columns only
# npm run ops:sync-env      # push .env.local → Vercel production
# npm run ops:inspect-db   # list public tables + project host
# npm run client:certify   # L4 SQL certification gate

# ─── Optional commerce integrations ───
# PAYHERE_MERCHANT_ID=
# PAYHERE_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=grabber_dev_verify
# KOOMBIYO_API_KEY=

# ─── Re-test / cert (optional) ───
# CERTIFY_HTTP_BASE_URL=https://your-app.vercel.app
