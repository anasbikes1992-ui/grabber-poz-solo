# =============================================================================
# GRABBER BUSINESS OS (SOLO) — Environment template
# Copy to .env.local and fill secrets. Never commit real keys.
# Live app: https://grabber-business-os.vercel.app
# =============================================================================

# ─── Core (required) ───
# Business OS Postgres project (NOT Grabber MyPoz sauzjjbkfyhfntcitpuz)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Vercel / serverless preferred:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

NEXT_PUBLIC_APP_URL=https://grabber-business-os.vercel.app
AUTH_SECRET=replace-with-openssl-rand-base64-48
MASTER_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

NEXT_PUBLIC_STORE_NAME=Grabber Business OS

# ─── Supabase client (optional — same project as DATABASE_URL) ───
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional commerce integrations ───
# PAYHERE_MERCHANT_ID=
# PAYHERE_SECRET=
# PAYHERE_MODE=sandbox
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# KOOMBIYO_API_KEY=
# OPENAI_API_KEY=

# ─── Re-test / cert (optional) ───
# CERTIFY_HTTP_BASE_URL=https://grabber-business-os.vercel.app
