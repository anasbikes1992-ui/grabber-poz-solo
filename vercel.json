{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "installCommand": "npm ci",
  "buildCommand": "node scripts/bootstrap-db.mjs && npm run build",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"dev\" ]",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
